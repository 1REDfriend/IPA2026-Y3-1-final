# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Bot Access Token from developer.webex.com (bot account).
WEBEX_BOT_TOKEN=

# Router credentials given by the instructor.
ROUTER_USER=
ROUTER_PASS=

# Optional: shared secret Webex uses to sign webhook deliveries.
WEBEX_WEBHOOK_SECRET=

# Optional: fixed public HTTPS URL. Leave empty to use the Quick Tunnel.
PUBLIC_URL=

# Host port for http://127.0.0.1:<HOST_PORT>/health
HOST_PORT=28475

# Tester only (scripts/live_test.py): Personal Access Token of your
# own human Webex account, used to mention the bot in the test room.
WEBEX_TESTER_TOKEN=
